{
  "name": "hack-the-soc",
  "version": "1.0.0",
  "private": true,
  "description": "HACK THE SOC - Enterprise-grade SOC analyst training platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "supabase:local": "node scripts/setup-local-supabase.mjs",
    "validate:logs": "node scripts/validate-log-fields.mjs",
    "validate:logs:baseline": "node scripts/validate-log-fields.mjs --baseline",
    "validate:logs:vendors": "node scripts/validate-log-fields.mjs --unknown-vendors",
    "normalize:vendors": "node scripts/normalize-vendors.mjs",
    "normalize:vendors:write": "node scripts/normalize-vendors.mjs --write",
    "backfill:vendors": "node scripts/backfill-missing-vendors.mjs",
    "validate:scenarios": "tsx scripts/validate-scenarios.mjs",
    "validate:content": "tsx scripts/validate-content.mjs",
    "validate:diagrams": "tsx scripts/validate-diagrams.mjs",
    "validate:hashes": "node scripts/validate-malware-hashes.mjs",
    "audit:scenarios": "tsx scripts/audit-scenarios.mjs",
    "audit:deps": "node scripts/audit-gate.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/test-backend-e2e.mjs",
    "test:tenancy": "node scripts/test-multitenancy-local.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.11.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.453.0",
    "mermaid": "^11.16.1",
    "next": "^15.5.21",
    "openai": "^6.38.0",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "//overrides": [
    "Security pins for TRANSITIVE deps we don't declare directly. npm's own",
    "`fixAvailable` for these pointed at `next@16` (a major bump) or at a",
    "pptxgenjs DOWNGRADE — neither is the actual fix, because the flaw is in the",
    "nested package, not in the parent that pulls it. Pinning here patches the",
    "vulnerable package while leaving the parent's major version alone.",
    "postcss  <=8.5.22 — path traversal + arbitrary .map disclosure via a crafted",
    "         sourceMappingURL. We declare postcss directly (Tailwind), so the",
    "         override is `$postcss` — npm's 'use my own direct version' idiom.",
    "         A literal range here is an EOVERRIDE error, and bumping only the",
    "         direct dep leaves next's nested copy on the vulnerable version.",
    "sharp    <0.35.0  — inherited libvips CVE-2026-33327/33328/35590/35591.",
    "dompurify <=3.4.12 — IN_PLACE hook removal leaves a detached subtree",
    "         executable (XSS). Reaches us only via jspdf and mermaid.",
    "Re-check on every dependency bump: an override silently keeps applying",
    "long after the parent has shipped its own fix."
  ],
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.3",
    "dompurify": "^3.4.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.21",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
