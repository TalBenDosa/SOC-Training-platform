{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  /**
   * `promo` / `promo-remotion` are standalone side projects (marketing video
   * and capture harnesses) that ship their own package.json + tsconfig and
   * their own React/Remotion versions. The include glob above swept them into
   * the app's type universe, where Remotion's components typecheck against the
   * WRONG React types and fail — which broke `next build` for the whole app
   * over code that isn't part of it. Excluded for the same reason `scripts` is.
   */
  "exclude": ["node_modules", "scripts", "promo", "promo-remotion"]
}
